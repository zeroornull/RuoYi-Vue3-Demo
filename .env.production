# Page title
VITE_APP_TITLE=若依管理系统

# Vite mode name for this file. Distinct from NODE_ENV.
VITE_APP_ENV=production

# Production API prefix.
VITE_APP_BASE_API=/prod-api

# Optional build-time compress list. Deploy layer gzip is preferred;
# this value is validated, not used to enable a Vite compress plugin.
VITE_BUILD_COMPRESS=gzip
