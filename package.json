{
  "name": "ruoyi-vue3-bun-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "env:check": "bun scripts/env-check.ts",
    "lab:ts": "bunx --bun tsc --noEmit -p learning/ts-lab/tsconfig.json",
    "test": "bun test tests/unit tests/system tests/monitor tests/tools tests/codegen && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run test && bun run lint && bun run format:check && bun run build:prod",
    "dev": "bunx --bun vite",
    "dev:backend": "VITE_MOCK_API=false bunx --bun vite",
    "typecheck": "vue-tsc --build",
    "build": "bun run typecheck && bunx --bun vite build",
    "build:stage": "bun run typecheck && bunx --bun vite build --mode staging",
    "build:prod": "bun run typecheck && bunx --bun vite build --mode production",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueup/vue-quill": "1.5.5",
    "axios": "1.19.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.5",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "js-beautify": "2.0.3",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.5.4",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "sortablejs": "1.15.7",
    "vue": "3.5.41",
    "vue-cropper": "1.1.4",
    "vue-router": "5.2.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/js-beautify": "1.14.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "22.20.1",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "prettier": "3.9.6",
    "sass-embedded": "1.103.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
