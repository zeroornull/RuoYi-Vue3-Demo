{
  "name": "ruoyi-vue3-bun-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "env:check": "bun scripts/env-check.ts",
    "lab:ts": "bunx --bun tsc --noEmit -p learning/ts-lab/tsconfig.json",
    "test": "bun test tests/unit",
    "dev": "bunx --bun vite",
    "typecheck": "vue-tsc --build",
    "build": "bun run typecheck && bunx --bun vite build",
    "build:stage": "bun run typecheck && bunx --bun vite build --mode staging",
    "build:prod": "bun run typecheck && bunx --bun vite build --mode production",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "element-plus": "2.14.5",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "sass-embedded": "1.103.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
