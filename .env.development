# Page title
VITE_APP_TITLE=若依管理系统

# Vite mode name for this file. Distinct from NODE_ENV.
VITE_APP_ENV=development

# Dev server proxy prefix. Rewritten to the backend origin.
VITE_APP_BASE_API=/dev-api

# Local mock for login/captcha/profile when no Java backend is on :8080.
# Set to false (or use `bun run dev:backend`) to proxy to localhost:8080.
VITE_MOCK_API=true
